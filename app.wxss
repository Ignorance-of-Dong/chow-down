/* app.wxss - 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 主题色 */
.primary {
  color: #FF6B6B;
}

.bg-primary {
  background-color: #FF6B6B;
}

/* 通用容器 */
.container {
  padding: 20rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-secondary {
  background: #f5f5f5;
  color: #666;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-meat {
  background: #FFE4E4;
  color: #FF6B6B;
}

.tag-vegetable {
  background: #E4F7E4;
  color: #52C41A;
}

.tag-soup {
  background: #FFF3E0;
  color: #FF9800;
}

.tag-staple {
  background: #E8F4FD;
  color: #1890FF;
}

/* 订单状态 */
.status-pending {
  color: #FAAD14;
}

.status-cooking {
  color: #1890FF;
}

.status-completed {
  color: #52C41A;
}
