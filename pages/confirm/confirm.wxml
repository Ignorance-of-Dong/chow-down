<!--pages/confirm/confirm.wxml-->
<view class="page">
  <!-- 顶部订单信息 -->
  <view class="header">
    <view class="header-title">确认订单</view>
    <view class="order-info">
      <view class="info-item">
        <text class="info-icon">📅</text>
        <text class="info-text">{{date}}</text>
      </view>
      <view class="info-item">
        <text class="info-icon">🍽️</text>
        <text class="info-text">{{mealName}}</text>
      </view>
      <view class="info-item">
        <text class="info-icon">🔢</text>
        <text class="info-text">共 {{totalQuantity}} 道菜</text>
      </view>
    </view>
  </view>

  <!-- 菜品列表 -->
  <view class="dish-section">
    <view class="section-title">
      <text>已选菜品</text>
      <text class="section-count">{{items.length}} 种</text>
    </view>
    
    <view class="dish-list">
      <view class="dish-item" wx:for="{{items}}" wx:key="id">
        <view class="dish-main">
          <view class="dish-icon">🍽️</view>
          <view class="dish-content">
            <view class="dish-name">{{item.name}}</view>
            <view class="dish-price">¥{{item.price}}</view>
          </view>
          <view class="dish-actions">
            <view class="action-btn minus" data-index="{{index}}" catchtap="decreaseQuantity">-</view>
            <text class="action-num">{{item.quantity}}</text>
            <view class="action-btn plus" data-index="{{index}}" catchtap="increaseQuantity">+</view>
          </view>
        </view>
        <view class="dish-remark">
          <input
            placeholder="备注（如：不放辣椒）"
            value="{{item.remark}}"
            data-index="{{index}}"
            bindinput="onRemarkInput"
            placeholder-class="remark-placeholder"
          />
        </view>
        <view class="remove-btn" data-index="{{index}}" catchtap="removeItem">
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">合计</text>
      <view class="total-price">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{totalPrice}}</text>
      </view>
    </view>
    <view class="submit-btn {{loading ? 'disabled' : ''}}" bindtap="submitOrder">
      <text>{{loading ? '提交中...' : '提交订单'}}</text>
    </view>
  </view>
</view>
