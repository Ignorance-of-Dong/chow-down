<!--pages/confirm/confirm.wxml-->
<view class="page">
  <!-- 订单信息 -->
  <view class="order-info card">
    <view class="info-row">
      <text class="label">用餐日期</text>
      <text class="value">{{date}}</text>
    </view>
    <view class="info-row">
      <text class="label">用餐餐次</text>
      <text class="value">{{mealName}}</text>
    </view>
    <view class="info-row">
      <text class="label">菜品数量</text>
      <text class="value primary">{{totalQuantity}} 道</text>
    </view>
  </view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <view class="list-title">已选菜品</view>
    <view class="dish-item card" wx:for="{{items}}" wx:key="id">
      <view class="dish-header">
        <view class="dish-name">{{item.name}}</view>
        <view class="remove-btn" data-index="{{index}}" bindtap="removeItem">
          <text>删除</text>
        </view>
      </view>
      <view class="dish-actions">
        <view class="quantity-control">
          <view class="btn" data-index="{{index}}" bindtap="decreaseQuantity">
            <text>-</text>
          </view>
          <text class="quantity">{{item.quantity}}</text>
          <view class="btn" data-index="{{index}}" bindtap="increaseQuantity">
            <text>+</text>
          </view>
        </view>
      </view>
      <view class="remark-input">
        <input
          placeholder="备注（如：不放辣椒）"
          value="{{item.remark}}"
          data-index="{{index}}"
          bindinput="onRemarkInput"
        />
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button
      class="submit-btn"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="submitOrder"
    >
      提交订单
    </button>
  </view>
</view>
