/* pages/confirm/confirm.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 180rpx;
}

/* 顶部订单信息 */
.header {
  background: linear-gradient(180deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 30rpx 30rpx 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 24rpx;
}

.order-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  padding: 16rpx 24rpx;
  border-radius: 30rpx;
}

.info-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.info-text {
  font-size: 26rpx;
  color: #fff;
}

/* 菜品区域 */
.dish-section {
  padding: 0 20rpx;
  margin-top: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  font-weight: 400;
  color: #999;
}

.dish-list {
  margin-top: 10rpx;
}

.dish-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.dish-main {
  display: flex;
  align-items: center;
}

.dish-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFE4E4 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.dish-content {
  flex: 1;
  margin-left: 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-price {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 500;
}

.dish-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
}

.action-btn.plus {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
}

.action-btn.minus {
  background: #f5f5f5;
  color: #999;
  border: 1rpx solid #ddd;
}

.action-num {
  font-size: 28rpx;
  font-weight: 500;
  min-width: 40rpx;
  text-align: center;
}

.dish-remark {
  margin-top: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
}

.dish-remark input {
  font-size: 26rpx;
  color: #333;
}

.remark-placeholder {
  color: #bbb;
}

.remove-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #FF6B6B;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.total-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 500;
}

.price-value {
  font-size: 44rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.submit-btn {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.submit-btn.disabled {
  opacity: 0.7;
}
