/* pages/profile/profile.wxss */
.user-section {
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.info {
  flex: 1;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.role {
  font-size: 26rpx;
  color: #666;
}

.login-hint {
  text-align: center;
  padding: 40rpx 0;
}

.login-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.menu-section {
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 2rpx;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
}

.menu-arrow {
  color: #ccc;
  font-size: 36rpx;
}

.about-section {
  text-align: center;
  padding: 60rpx 0;
}

.version {
  display: block;
  color: #999;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.copyright {
  display: block;
  color: #bbb;
  font-size: 22rpx;
}
