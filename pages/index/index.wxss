/* pages/index/index.wxss */
.page {
  padding-bottom: 120rpx;
}

.header {
  position: sticky;
  top: 0;
  z-index: 10;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.date-picker .label {
  color: #666;
}

.picker-value {
  color: #FF6B6B;
  font-weight: 500;
}

.meal-tabs {
  display: flex;
  gap: 16rpx;
}

.meal-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  transition: all 0.2s;
}

.meal-tab.active {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
}

/* 菜品分类 */
.category-section {
  margin-bottom: 30rpx;
}

.category-title {
  font-size: 32rpx;
  font-weight: 600;
  padding: 20rpx 0;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.category-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: #FF6B6B;
  border-radius: 3rpx;
}

.dish-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

/* 菜品卡片 */
.dish-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: #f5f5f5;
}

.dish-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.dish-info {
  padding: 16rpx;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-time {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.add-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.add-btn:active {
  transform: scale(0.95);
}

/* 购物车栏 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.cart-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cart-icon {
  position: relative;
  font-size: 40rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #FF6B6B;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.cart-text {
  font-size: 28rpx;
  color: #333;
}

.cart-actions {
  display: flex;
  gap: 20rpx;
}

.clear-btn {
  padding: 16rpx 32rpx;
  color: #999;
  font-size: 26rpx;
}

.submit-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}
