/* pages/index/index.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 顶部栏 */
.header {
  background: linear-gradient(180deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 0 20rpx 20rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.location {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.location-icon {
  font-size: 32rpx;
}

.location-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.search-icon {
  font-size: 36rpx;
  filter: brightness(10);
}

.meal-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.meal-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.meal-tab::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0);
  transition: all 0.3s ease;
}

.meal-tab.active::before {
  background: rgba(255, 255, 255, 1);
}

.meal-tab.active {
  background: #fff;
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.meal-name {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.meal-tab.active .meal-name {
  color: #FF6B6B;
  font-weight: 600;
}

.meal-time {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
  position: relative;
  z-index: 1;
}

.meal-tab.active .meal-time {
  color: #FFB5B5;
}

/* 主体区域 */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类栏 */
.category-bar {
  width: 180rpx;
  background: #f5f5f5;
  height: 100%;
}

.category-item {
  position: relative;
  padding: 30rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-left: 6rpx solid transparent;
}

.category-item.active {
  background: #fff;
  color: #FF6B6B;
  font-weight: 600;
  border-left-color: #FF6B6B;
}

.category-badge {
  position: absolute;
  top: 16rpx;
  right: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 右侧菜品区域 */
.dish-area {
  flex: 1;
  height: 100%;
  background: #fff;
  padding-bottom: 220rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  color: #999;
}

.dish-section {
  padding: 0 20rpx;
}

.section-title {
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-list {
  padding-bottom: 20rpx;
}

.dish-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-image-wrap {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dish-image-default {
  background: linear-gradient(180deg, #FFF5F5 0%, #FFE4E4 100%);
  font-size: 80rpx;
}

.dish-content {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-sales {
  font-size: 22rpx;
  color: #999;
  margin-bottom: auto;
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.dish-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 500;
}

.price-value {
  font-size: 36rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.dish-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
}

.action-btn.plus {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
}

.action-btn.minus {
  background: #f5f5f5;
  color: #999;
  border: 1rpx solid #ddd;
}

.action-num {
  font-size: 28rpx;
  font-weight: 500;
  min-width: 40rpx;
  text-align: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

/* 购物车栏 */
.cart-bar {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 50;
}

.cart-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cart-icon-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4A4A4A 0%, #2D2D2D 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -30rpx;
}

.cart-bar.has-items .cart-icon-wrap {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.cart-icon {
  font-size: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 18rpx;
  padding: 0 10rpx;
}

.cart-info {
  display: flex;
  flex-direction: column;
}

.cart-price {
  display: flex;
  align-items: baseline;
}

.cart-price .price-symbol {
  font-size: 24rpx;
}

.cart-price .price-value {
  font-size: 40rpx;
}

.cart-empty {
  font-size: 30rpx;
  color: #999;
}

.submit-btn {
  padding: 24rpx 50rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.submit-btn.active {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
}

.submit-btn.disabled {
  background: #ddd;
  color: #999;
}

/* 购物车弹窗 */
.cart-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.cart-popup {
  position: absolute;
  bottom: calc(240rpx + env(safe-area-inset-bottom));
  left: 20rpx;
  right: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 600;
}

.popup-clear {
  font-size: 26rpx;
  color: #FF6B6B;
}

.popup-list {
  max-height: 50vh;
}

.popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-name {
  flex: 1;
  font-size: 28rpx;
}

.popup-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.popup-price {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 500;
}

.popup-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
