<!--pages/index/index.wxml-->
<view class="page">
  <!-- 顶部栏 -->
  <view class="header">
    <view class="header-top">
      <view class="location">
        <text class="location-icon">📍</text>
        <text class="location-text">家庭点餐</text>
      </view>
      <view class="header-actions">
        <text class="search-icon">🔍</text>
      </view>
    </view>
    <view class="meal-tabs">
      <view
        wx:for="{{meals}}"
        wx:key="value"
        class="meal-tab {{selectedMeal === item.value ? 'active' : ''}}"
        data-meal="{{item.value}}"
        bindtap="onMealSelect"
      >
        <text class="meal-name">{{item.label}}</text>
        <text class="meal-time">{{item.time}}</text>
      </view>
    </view>
  </view>

  <!-- 主体区域 -->
  <view class="main-content">
    <!-- 左侧分类栏 -->
    <scroll-view class="category-bar" scroll-y>
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="category-item {{currentCategory === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="onCategoryTap"
      >
        <text>{{item}}</text>
        <view wx:if="{{categoryCounts[item] > 0}}" class="category-badge">{{categoryCounts[item]}}</view>
      </view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view 
      class="dish-area" 
      scroll-y 
      scroll-into-view="{{intoView}}"
      scroll-with-animation
      bindscroll="onScroll"
    >
      <!-- 加载中 -->
      <view wx:if="{{loading}}" class="loading">
        <text>加载中...</text>
      </view>

      <!-- 菜品列表 -->
      <view wx:else>
        <block wx:for="{{categories}}" wx:key="*this">
          <view wx:if="{{dishesByCategory[item].length > 0}}" class="dish-section" id="cat-{{item}}">
            <view class="section-title">{{item}}</view>
            <view class="dish-list">
              <view
                wx:for="{{dishesByCategory[item]}}"
                wx:for-item="dish"
                wx:key="id"
                class="dish-item"
              >
                <image
                  class="dish-image"
                  src="{{dish.image || '/images/default-dish.png'}}"
                  mode="aspectFill"
                />
                <view class="dish-content">
                  <view class="dish-name">{{dish.name}}</view>
                  <view class="dish-desc" wx:if="{{dish.description}}">{{dish.description}}</view>
                  <view class="dish-sales">
                    <text>月售 {{dish.sales || 99}}</text>
                  </view>
                  <view class="dish-bottom">
                    <view class="dish-price">
                      <text class="price-symbol">¥</text>
                      <text class="price-value">{{dish.price}}</text>
                    </view>
                    <view class="dish-actions">
                      <view 
                        wx:if="{{cartMap[dish.id]}}" 
                        class="action-btn minus"
                        data-dish="{{dish}}"
                        catchtap="removeFromCart"
                      >-</view>
                      <text wx:if="{{cartMap[dish.id]}}" class="action-num">{{cartMap[dish.id]}}</text>
                      <view 
                        class="action-btn plus"
                        data-dish="{{dish}}"
                        catchtap="addToCart"
                      >+</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>

        <!-- 空状态 -->
        <view wx:if="{{!hasDishes}}" class="empty-state">
          <text class="empty-icon">🍽️</text>
          <text class="empty-text">暂无可用菜品</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar {{cartCount > 0 ? 'has-items' : ''}}">
    <view class="cart-left">
      <view class="cart-icon-wrap" bindtap="toggleCartPopup">
        <text class="cart-icon">🛒</text>
        <view wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</view>
      </view>
      <view class="cart-info">
        <view wx:if="{{cartCount > 0}}" class="cart-price">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{totalPrice}}</text>
        </view>
        <text wx:else class="cart-empty">购物车是空的</text>
      </view>
    </view>
    <view class="cart-right">
      <view class="submit-btn {{cartCount > 0 ? 'active' : 'disabled'}}" bindtap="goToConfirm">
        <text>{{cartCount > 0 ? '去结算' : '请选择菜品'}}</text>
      </view>
    </view>
  </view>

  <!-- 购物车弹窗 -->
  <view wx:if="{{showCartPopup}}" class="cart-popup-mask" bindtap="toggleCartPopup">
    <view class="cart-popup" catchtap>
      <view class="popup-header">
        <text class="popup-title">已选菜品</text>
        <text class="popup-clear" bindtap="clearCart">清空</text>
      </view>
      <scroll-view class="popup-list" scroll-y>
        <view wx:for="{{cart}}" wx:key="id" class="popup-item">
          <text class="popup-name">{{item.name}}</text>
          <view class="popup-right">
            <text class="popup-price">¥{{item.price}}</text>
            <view class="popup-actions">
              <view class="action-btn minus" data-dish="{{item}}" catchtap="removeFromCart">-</view>
              <text class="action-num">{{item.quantity}}</text>
              <view class="action-btn plus" data-dish="{{item}}" catchtap="addToCart">+</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
