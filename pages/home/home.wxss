/* pages/home/home.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FF6B6B 0%, #FF8E8E 50%, #FFA07A 100%);
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: #fff;
}

.loading .logo {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.loading text {
  font-size: 28rpx;
  opacity: 0.9;
}

.register {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  min-height: 100vh;
}

.register .logo {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 60rpx;
  text-align: center;
}

.form {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 50rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 100rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  border: 4rpx solid #FF6B6B;
}

.nickname-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  padding: 20rpx 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.submit-btn {
  width: 85%;
  height: 100rpx;
  line-height: 100rpx;
  background: #fff;
  color: #FF6B6B;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
}

.submit-btn:active {
  transform: scale(0.98);
}
