/* pages/home/home.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.logo {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  margin-bottom: 80rpx;
}

.login-btn {
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
  background: #fff;
  color: #FF6B6B;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
}

.login-btn:active {
  opacity: 0.9;
}

.tips {
  margin-top: 40rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}
