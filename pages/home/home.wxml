<!--pages/home/home.wxml-->
<view class="container">
  <view class="logo">🍽️</view>
  <view class="title">家庭点餐助手</view>
  <view class="desc">让家人提前选菜，厨师根据订单准备</view>
  
  <!-- 用户信息填写 -->
  <view class="form">
    <view class="form-item">
      <text class="label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
      </button>
    </view>
    <view class="form-item">
      <text class="label">昵称</text>
      <input 
        class="nickname-input" 
        type="nickname" 
        placeholder="请输入昵称" 
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        value="{{nickname}}"
      />
    </view>
  </view>
  
  <button class="login-btn" loading="{{loading}}" bindtap="handleLogin">
    开始点餐
  </button>
  
  <view class="tips">
    <text>设置头像和昵称后即可开始点餐</text>
  </view>
</view>
