<!--pages/orders/orders.wxml-->
<view class="page fade-in">
  <!-- 管理员标识 -->
  <view wx:if="{{isAdmin}}" class="admin-badge">
    <text>👨‍🍳 管理员视角 - 查看所有订单</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 订单列表 -->
  <view wx:elif="{{orders.length > 0}}" class="order-list">
    <view
      class="order-card card slide-up"
      wx:for="{{orders}}"
      wx:key="id"
      style="animation-delay: {{index * 0.05}}s;"
    >
      <view class="order-header">
        <view class="order-info">
          <text class="order-date">{{item.formattedDate}}</text>
          <text class="order-meal">{{item.meal_type === 'breakfast' ? '早餐' : item.meal_type === 'lunch' ? '午餐' : item.meal_type === 'dinner' ? '晚餐' : '夜宵'}}</text>
        </view>
        <view class="order-status {{item.status === 'pending' ? 'status-pending' : item.status === 'preparing' || item.status === 'ready' ? 'status-cooking' : 'status-completed'}}">
          {{item.status === 'pending' ? '待处理' : item.status === 'preparing' ? '准备中' : item.status === 'ready' ? '已就绪' : '已完成'}}
        </view>
      </view>

      <view class="order-dishes">
        <text wx:for="{{item.items}}" wx:for-item="dish" wx:key="dish_id">
          {{dish.name || dish.dish_name}} x{{dish.quantity}}
        </text>
      </view>

      <view class="order-footer">
        <text class="order-time">{{item.formattedTime}}</text>
        <view wx:if="{{isAdmin && item.status !== 'completed'}}" class="status-btn" catchtap="updateStatus" data-id="{{item.id}}" data-status="{{item.status === 'pending' ? 'preparing' : item.status === 'preparing' ? 'ready' : 'completed'}}">
          {{item.status === 'pending' ? '开始准备' : item.status === 'preparing' ? '标记就绪' : '完成'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <view class="icon">📋</view>
    <text>暂无订单</text>
    <view class="hint">去点餐页面选择喜欢的菜品吧</view>
  </view>
</view>
