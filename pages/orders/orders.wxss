/* pages/orders/orders.wxss */
.admin-badge {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 16rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
}

.order-list {
  padding: 20rpx;
}

.order-card {
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-info {
  display: flex;
  gap: 16rpx;
}

.order-date {
  font-weight: 600;
  color: #333;
}

.order-meal {
  color: #666;
  font-size: 26rpx;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  background: #FFF7E6;
  color: #FAAD14;
}

.status-cooking {
  background: #E6F7FF;
  color: #1890FF;
}

.status-completed {
  background: #F6FFED;
  color: #52C41A;
}

.order-dishes {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.order-dishes text {
  background: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.status-btn {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
}

.empty-state {
  padding: 150rpx 40rpx;
  text-align: center;
}

.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-state text {
  display: block;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-state .hint {
  font-size: 24rpx;
  color: #bbb;
}
